# ============================================
# Randol's Agentic Social Media Marketing Platform
# Environment Variables Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================

# ============================================
# APPLICATION SETTINGS
# ============================================
FLASK_ENV=development
FLASK_DEBUG=1
LOG_LEVEL=DEBUG
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MongoDB Atlas (recommended for production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/randols_marketing?retryWrites=true&w=majority

# Local MongoDB (development)
# MONGODB_URI=mongodb://localhost:27017/randols_marketing

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Or use full URL:
# REDIS_URL=redis://localhost:6379/0

# ============================================
# AI/ML API KEYS
# ============================================
# OpenAI - Required for content generation
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model Settings (optional)
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# ============================================
# SOCIAL MEDIA PLATFORM CREDENTIALS
# ============================================
# Instagram/Facebook (Meta Graph API)
# Get from: https://developers.facebook.com/
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-id
FACEBOOK_ACCESS_TOKEN=your-facebook-page-access-token
FACEBOOK_PAGE_ID=your-facebook-page-id
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# TikTok
# Get from: https://developers.tiktok.com/
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# YouTube (Google API)
# Get from: https://console.cloud.google.com/
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CHANNEL_ID=your-youtube-channel-id
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# Google Business Profile
GOOGLE_POSTS_API_KEY=your-google-posts-api-key
GOOGLE_BUSINESS_LOCATION_ID=your-business-location-id

# ============================================
# MEDIA GENERATION SERVICES
# ============================================
# ElevenLabs (Voice generation)
# Get from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id

# Canva (Image generation)
# Get from: https://www.canva.com/developers/
CANVA_API_KEY=your-canva-api-key
CANVA_BRAND_KIT_ID=your-brand-kit-id

# ============================================
# EXTERNAL DATA APIS
# ============================================
# Weather (for context-aware content)
# Get from: https://openweathermap.org/api
WEATHER_API_KEY=your-openweathermap-api-key
WEATHER_LOCATION=Breaux Bridge,LA,US

# Local Events API (optional)
LAFAYETTE_EVENTS_API=your-local-events-api-key

# ============================================
# NOTIFICATION WEBHOOKS
# ============================================
# Slack
# Get from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#marketing-alerts

# Discord (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK

# Email Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=notifications@yourdomain.com

# ============================================
# CLOUD STORAGE (for media files)
# ============================================
# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=randols-marketing-media
AWS_REGION=us-east-1

# Google Cloud Storage (alternative)
# GCS_BUCKET=randols-marketing-media
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ============================================
# RESTAURANT INFORMATION
# ============================================
RESTAURANT_NAME=Randol's Restaurant
RESTAURANT_LOCATION=Breaux Bridge, Louisiana
RESTAURANT_ADDRESS=325 West Mills Avenue, Breaux Bridge, LA 70573
RESTAURANT_PHONE=(337) 332-4648
RESTAURANT_WEBSITE=https://randols.com
RESTAURANT_ESTABLISHED=1973

# Business Hours (JSON format)
RESTAURANT_HOURS={"monday":"11:00-21:00","tuesday":"11:00-21:00","wednesday":"11:00-21:00","thursday":"11:00-21:00","friday":"11:00-22:00","saturday":"11:00-22:00","sunday":"11:00-21:00"}

# ============================================
# BRAND SETTINGS
# ============================================
BRAND_PRIMARY_COLOR=#C0152F
BRAND_SECONDARY_COLOR=#A84B2F
BRAND_ACCENT_COLOR=#32808D
BRAND_GOLD_COLOR=#D4AF37

# ============================================
# PERFORMANCE THRESHOLDS
# ============================================
ENGAGEMENT_THRESHOLD_EXCELLENT=0.06
ENGAGEMENT_THRESHOLD_GOOD=0.04
ENGAGEMENT_THRESHOLD_AVERAGE=0.025
ENGAGEMENT_THRESHOLD_POOR=0.015

# Authenticity threshold for brand voice
AUTHENTICITY_THRESHOLD=0.75

# ============================================
# SCHEDULING SETTINGS
# ============================================
TIMEZONE=America/Chicago
SCHEDULER_INTERVAL_SECONDS=60
MAX_POSTS_PER_DAY=15
MIN_POST_INTERVAL_MINUTES=30

# ============================================
# MONITORING & ANALYTICS
# ============================================
# Sentry (error tracking)
# Get from: https://sentry.io/
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# Mixpanel (optional)
MIXPANEL_TOKEN=your-mixpanel-token

# OpenTelemetry (observability)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=randols-marketing

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
# Mock mode (don't actually post to social media)
MOCK_SOCIAL_POSTS=true

# Demo mode (use sample data)
DEMO_MODE=true

# Enable detailed logging
VERBOSE_LOGGING=true

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
# API Keys for authentication
API_KEY=rnd_generate-a-secure-api-key-here
API_KEY_SECONDARY=rnd_generate-another-secure-key-here
ADMIN_API_KEY=rnd_generate-admin-api-key-here

# JWT Settings
JWT_SECRET=your-jwt-secret-key-at-least-32-characters-long

# API rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Allowed IPs (comma-separated, empty for all)
ALLOWED_IPS=

# Admin credentials (for initial setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password-immediately
ADMIN_EMAIL=admin@yourdomain.com

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_AI_CONTENT_GENERATION=true
ENABLE_AUTO_SCHEDULING=true
ENABLE_ANALYTICS_COLLECTION=true
ENABLE_VOICE_GENERATION=false
ENABLE_VIDEO_GENERATION=false
ENABLE_AB_TESTING=true
ENABLE_EMERGENCY_OVERRIDE=true
