{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Randol's Platform Environment Variables Schema",
  "description": "Schema for validating environment variables before application startup",
  "type": "object",
  "properties": {
    "FLASK_ENV": {
      "type": "string",
      "enum": ["development", "staging", "production"],
      "default": "development",
      "description": "Flask environment mode"
    },
    "SECRET_KEY": {
      "type": "string",
      "minLength": 32,
      "required": true,
      "description": "Flask secret key for session encryption"
    },
    "JWT_SECRET_KEY": {
      "type": "string",
      "minLength": 32,
      "required": true,
      "description": "JWT signing secret"
    },
    "MONGODB_URI": {
      "type": "string",
      "pattern": "^mongodb(\\+srv)?://",
      "required": true,
      "description": "MongoDB connection string"
    },
    "REDIS_HOST": {
      "type": "string",
      "default": "localhost",
      "description": "Redis server hostname"
    },
    "REDIS_PORT": {
      "type": "integer",
      "default": 6379,
      "minimum": 1,
      "maximum": 65535,
      "description": "Redis server port"
    },
    "OPENAI_API_KEY": {
      "type": "string",
      "pattern": "^sk-[a-zA-Z0-9-_]+$",
      "required": true,
      "sensitive": true,
      "description": "OpenAI API key for content generation"
    },
    "OPENAI_MODEL": {
      "type": "string",
      "enum": ["gpt-4", "gpt-4-turbo", "gpt-4o", "gpt-3.5-turbo"],
      "default": "gpt-4",
      "description": "OpenAI model to use"
    },
    "OPENAI_MAX_TOKENS": {
      "type": "integer",
      "minimum": 100,
      "maximum": 4096,
      "default": 500,
      "description": "Maximum tokens for OpenAI responses"
    },
    "OPENAI_TEMPERATURE": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "default": 0.7,
      "description": "OpenAI temperature parameter"
    },
    "INSTAGRAM_ACCESS_TOKEN": {
      "type": "string",
      "sensitive": true,
      "description": "Instagram Graph API access token"
    },
    "INSTAGRAM_BUSINESS_ACCOUNT_ID": {
      "type": "string",
      "description": "Instagram Business Account ID"
    },
    "FACEBOOK_ACCESS_TOKEN": {
      "type": "string",
      "sensitive": true,
      "description": "Facebook Page access token"
    },
    "FACEBOOK_PAGE_ID": {
      "type": "string",
      "description": "Facebook Page ID"
    },
    "TIKTOK_ACCESS_TOKEN": {
      "type": "string",
      "sensitive": true,
      "description": "TikTok API access token"
    },
    "TIKTOK_CLIENT_KEY": {
      "type": "string",
      "sensitive": true,
      "description": "TikTok client key"
    },
    "TIKTOK_CLIENT_SECRET": {
      "type": "string",
      "sensitive": true,
      "description": "TikTok client secret"
    },
    "YOUTUBE_API_KEY": {
      "type": "string",
      "sensitive": true,
      "description": "YouTube Data API key"
    },
    "GOOGLE_CLIENT_ID": {
      "type": "string",
      "pattern": ".*\\.apps\\.googleusercontent\\.com$",
      "description": "Google OAuth client ID"
    },
    "GOOGLE_CLIENT_SECRET": {
      "type": "string",
      "sensitive": true,
      "description": "Google OAuth client secret"
    },
    "GOOGLE_POSTS_API_KEY": {
      "type": "string",
      "sensitive": true,
      "description": "Google My Business API key"
    },
    "ELEVENLABS_API_KEY": {
      "type": "string",
      "sensitive": true,
      "description": "ElevenLabs API key for voice generation"
    },
    "CANVA_API_KEY": {
      "type": "string",
      "sensitive": true,
      "description": "Canva API key"
    },
    "WEATHER_API_KEY": {
      "type": "string",
      "sensitive": true,
      "description": "OpenWeatherMap API key"
    },
    "SLACK_WEBHOOK_URL": {
      "type": "string",
      "pattern": "^https://hooks\\.slack\\.com/services/",
      "sensitive": true,
      "description": "Slack webhook URL for notifications"
    },
    "AWS_ACCESS_KEY_ID": {
      "type": "string",
      "sensitive": true,
      "description": "AWS access key ID"
    },
    "AWS_SECRET_ACCESS_KEY": {
      "type": "string",
      "sensitive": true,
      "description": "AWS secret access key"
    },
    "AWS_S3_BUCKET": {
      "type": "string",
      "description": "AWS S3 bucket name for media storage"
    },
    "RESTAURANT_NAME": {
      "type": "string",
      "default": "Randol's Restaurant",
      "description": "Restaurant name"
    },
    "RESTAURANT_LOCATION": {
      "type": "string",
      "default": "Breaux Bridge, Louisiana",
      "description": "Restaurant location"
    },
    "TIMEZONE": {
      "type": "string",
      "default": "America/Chicago",
      "description": "Default timezone for scheduling"
    },
    "MAX_POSTS_PER_DAY": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 15,
      "description": "Maximum posts per day across all platforms"
    },
    "AUTHENTICITY_THRESHOLD": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.75,
      "description": "Minimum authenticity score for content approval"
    },
    "RATE_LIMIT_ENABLED": {
      "type": "boolean",
      "default": true,
      "description": "Enable API rate limiting"
    },
    "RATE_LIMIT_PER_MINUTE": {
      "type": "integer",
      "minimum": 1,
      "default": 60,
      "description": "API requests per minute limit"
    },
    "RATE_LIMIT_PER_HOUR": {
      "type": "integer",
      "minimum": 1,
      "default": 1000,
      "description": "API requests per hour limit"
    },
    "MOCK_SOCIAL_POSTS": {
      "type": "boolean",
      "default": true,
      "description": "Mock social media posting (don't actually post)"
    },
    "DEMO_MODE": {
      "type": "boolean",
      "default": false,
      "description": "Enable demo mode with sample data"
    },
    "ENABLE_AI_CONTENT_GENERATION": {
      "type": "boolean",
      "default": true,
      "description": "Enable AI-powered content generation"
    },
    "ENABLE_AUTO_SCHEDULING": {
      "type": "boolean",
      "default": true,
      "description": "Enable automatic post scheduling"
    },
    "ENABLE_AB_TESTING": {
      "type": "boolean",
      "default": true,
      "description": "Enable A/B testing for content"
    },
    "OTEL_EXPORTER_OTLP_ENDPOINT": {
      "type": "string",
      "pattern": "^https?://",
      "description": "OpenTelemetry collector endpoint"
    },
    "OTEL_SERVICE_NAME": {
      "type": "string",
      "default": "randols-marketing",
      "description": "OpenTelemetry service name"
    },
    "SENTRY_DSN": {
      "type": "string",
      "pattern": "^https://.*@.*\\.ingest\\.sentry\\.io/",
      "sensitive": true,
      "description": "Sentry DSN for error tracking"
    }
  },
  "required": [
    "SECRET_KEY",
    "JWT_SECRET_KEY",
    "MONGODB_URI",
    "OPENAI_API_KEY"
  ],
  "requiredForProduction": [
    "SECRET_KEY",
    "JWT_SECRET_KEY",
    "MONGODB_URI",
    "OPENAI_API_KEY",
    "REDIS_HOST",
    "INSTAGRAM_ACCESS_TOKEN",
    "FACEBOOK_ACCESS_TOKEN"
  ],
  "sensitiveFields": [
    "SECRET_KEY",
    "JWT_SECRET_KEY",
    "OPENAI_API_KEY",
    "INSTAGRAM_ACCESS_TOKEN",
    "FACEBOOK_ACCESS_TOKEN",
    "TIKTOK_ACCESS_TOKEN",
    "TIKTOK_CLIENT_SECRET",
    "YOUTUBE_API_KEY",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_POSTS_API_KEY",
    "ELEVENLABS_API_KEY",
    "CANVA_API_KEY",
    "WEATHER_API_KEY",
    "SLACK_WEBHOOK_URL",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "SMTP_PASSWORD",
    "SENTRY_DSN"
  ]
}
